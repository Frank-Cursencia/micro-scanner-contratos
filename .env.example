SERVICE_NAME=micro-scanner-contratos
SERVICE_VERSION=0.1.0
ENVIRONMENT=development
HOST=127.0.0.1
PORT=4012
LOG_LEVEL=INFO

# Token compartido con el API Gateway para X-Service-Token.
MICROSERVICE_TOKEN=

# Gemini structured output.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_MAX_CONCURRENCY=2

# El PDF se envia inline; 14 MB mantiene margen para la conversion base64.
MAX_FILE_SIZE_MB=14
